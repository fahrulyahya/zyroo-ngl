{
  "version": 2,
  "builds": [
    {
      "src": "api/ngl.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/ngl",
      "dest": "/api/ngl.js",
      "methods": ["POST"]
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}